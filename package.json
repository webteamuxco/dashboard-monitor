{
  "name": "dashboard-monitor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint && pnpm lint:tests",
    "lint:tests": "eslint tests vitest.config.ts",
    "typecheck": "turbo run typecheck && pnpm typecheck:tests",
    "typecheck:tests": "tsc -p tsconfig.json",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@tanstack/react-query": "5.102.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "eslint": "^9.39.5",
    "git-cliff": "^2.13.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "turbo": "^2.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11",
    "zustand": "5.0.15"
  },
  "engines": {
    "node": ">=20.0.0 <=24.x.x"
  },
  "packageManager": "pnpm@10.33.3"
}
