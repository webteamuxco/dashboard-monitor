pnpm exec commitlint --edit "$1"
# docker-stack-process: commit-msg
stack_hook="$(git rev-parse --show-toplevel)/tools/docker-stack-process/git-hooks/commit-msg"
if [ -f "$stack_hook" ]; then
    sh "$stack_hook" "$@"
else
    echo "docker-stack-process: $stack_hook not found, hook skipped (https://github.com/webteamuxco/docker-stack-process is missing to folder tools/docker-stack-process)." >&2
fi
