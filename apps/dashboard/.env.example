# dashboard-monitor — environment variables
#
# Copy this file to `.env.local` and fill in the values.
# NEXT_PUBLIC_* vars are exposed to the browser and must stay non-sensitive
# (UI knobs). Provider secrets stay server-side only.
#
# Which adapter backs each monitor family is no longer an env choice: it comes
# from the project's mapped tools in Strapi admin (strategy `error-monitor`,
# `log-monitor`, `tracker-monitor` × tool slug). Instance URL, organization and
# project id come from the same place — only the API secrets live here.

# ──────────────────────────────────────────────────────────────────────────
# GlitchTip (error + log monitor) — server-only secret
# Required when a project maps glitchtip to its error/log monitor.
# ──────────────────────────────────────────────────────────────────────────
GLITCHTIP_TOKEN=

# ──────────────────────────────────────────────────────────────────────────
# PostHog (tracker monitor) — server-only secret
# Required when a project maps posthog to its tracker monitor.
# ──────────────────────────────────────────────────────────────────────────
POSTHOG_PERSONAL_API_KEY=

# ──────────────────────────────────────────────────────────────────────────
# Dashboard — server-only
# ──────────────────────────────────────────────────────────────────────────
# The active project is now selected in the header (from the Strapi project
# list) and persisted client-side — no default project env var is needed.
# The refresh cadence comes from each project's Strapi defaultConfig
# (DefaultRefreshIntervalMS); a 30s constant applies when it is absent.

# ──────────────────────────────────────────────────────────────────────────
# Dashboard — public (browser-exposed UI knobs)
# ──────────────────────────────────────────────────────────────────────────
# Title rendered in the dashboard header.
NEXT_PUBLIC_PROJECT_TITLE=UXCO Dashboard Monitor
# Allow user interaction with the dashboard ("true" / "false", default: false).
NEXT_PUBLIC_DASHBOARD_INTERACTIVITY=false
# Reservations time window in minutes (positive integer, default: 30).
NEXT_PUBLIC_DASHBOARD_RESERVATIONS_WINDOW_MINUTES=30
# Environment filter for issues + error rate. Comma-separated list shown in the
# header selector (e.g. production,staging). Empty disables the selector.
NEXT_PUBLIC_DASHBOARD_ENVIRONMENTS=
# Environment selected on load. Must be one of the values above; falls back to
# the first entry, or to "all environments" when the list is empty.
NEXT_PUBLIC_DASHBOARD_DEFAULT_ENVIRONMENT=
# Default config-panel values for the GlitchTip feature.
NEXT_PUBLIC_DASHBOARD_DEFAULT_ORGANIZATION_SLUG=
NEXT_PUBLIC_DASHBOARD_DEFAULT_POLLING_INTERVAL_SEC=30
NEXT_PUBLIC_DASHBOARD_DEFAULT_METRICS_ENDPOINT=
NEXT_PUBLIC_STRAPI_ADMIN_URL=http://localhost:1337
NEXT_PUBLIC_DOCS_SITE_URL=http://localhost:3002/docs

# ──────────────────────────────────────────────────────────────────────────
# Dashboard ADMIN
# ──────────────────────────────────────────────────────────────────────────
# Strapi instance root — no trailing path. The GraphQL endpoint is derived as
# `<root>/graphql`, so a value ending in `/api` makes every request fail with
# 405 Method Not Allowed.
STRAPI_BASE_URL=http://localhost:1337
STRAPI_TOKEN=