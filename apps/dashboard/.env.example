# dashboard-monitor — environment variables
#
# Copy this file to `apps/dashboard/.env.local` and fill in the values.
# This file belongs to the dashboard app, not to the monorepo root.
# NEXT_PUBLIC_* vars are exposed to the browser and must stay non-sensitive
# (UI knobs). Provider secrets stay server-side only.
#
# Which adapter backs each monitor family is no longer an env choice: it comes
# from the DASHBOARD PANEL's mapped tools in Strapi admin (strategy
# `error-monitor`, `log-monitor`, `tracker-monitor` × tool slug). Instance URL,
# organization and provider project id come from the same place — only the API
# secrets live here. A Strapi project owns an ordered list of panels; the header
# switches between them.

# ──────────────────────────────────────────────────────────────────────────
# GlitchTip (error + log monitor) — server-only secret
# Required as soon as a panel maps glitchtip to its error/log monitor.
# ──────────────────────────────────────────────────────────────────────────
GLITCHTIP_TOKEN=

# ──────────────────────────────────────────────────────────────────────────
# PostHog (tracker monitor) — server-only secret
# Required as soon as a panel maps posthog to its tracker monitor.
# ──────────────────────────────────────────────────────────────────────────
POSTHOG_PERSONAL_API_KEY=

# ──────────────────────────────────────────────────────────────────────────
# Dashboard — server-only
# ──────────────────────────────────────────────────────────────────────────
# The active project and the active panel are selected in the header (from the
# Strapi project list, then its panels) and persisted client-side — no default
# project or panel env var is needed. On a fresh browser the first project and
# its first panel by `order` are used.
# The refresh cadence comes from each PROJECT's Strapi defaultConfig
# (DefaultRefreshIntervalMS); a 30s constant applies when it is absent.

# ──────────────────────────────────────────────────────────────────────────
# Dashboard — public (browser-exposed UI knobs)
# ──────────────────────────────────────────────────────────────────────────
# Title rendered in the dashboard header.
NEXT_PUBLIC_PROJECT_TITLE=UXCO Dashboard Monitor
# Allow user interaction with the dashboard ("true" / "false", default: false).
# When false, every header control is hidden (project, panel, environment and
# window selectors, refresh button, Admin and Documentation links).
NEXT_PUBLIC_DASHBOARD_INTERACTIVITY=false
# Fallback time window in minutes (positive integer, default: 30). Used only
# when the selected project declares no timeInterval in Strapi.
NEXT_PUBLIC_DASHBOARD_RESERVATIONS_WINDOW_MINUTES=30
# Environment filter for issues + error rate. Comma-separated list shown in the
# header selector (e.g. production,staging). Empty disables the selector.
NEXT_PUBLIC_DASHBOARD_ENVIRONMENTS=
# Environment selected on load. Must be one of the values above; falls back to
# the first entry, or to "all environments" when the list is empty.
NEXT_PUBLIC_DASHBOARD_DEFAULT_ENVIRONMENT=
# Target of the header "Admin" button (default: /admin).
NEXT_PUBLIC_STRAPI_ADMIN_URL=http://localhost:1337
# Target of the header "Documentation" button — the docs-site app. Its Docusaurus
# baseUrl is /docs/, so keep that path segment (default: /docs).
NEXT_PUBLIC_DOCS_SITE_URL=http://localhost:3002/docs

# ──────────────────────────────────────────────────────────────────────────
# Dashboard ADMIN
# ──────────────────────────────────────────────────────────────────────────
# Strapi instance root — no trailing path. The GraphQL endpoint is derived as
# `<root>/graphql`, so a value ending in `/api` makes every request fail with
# 405 Method Not Allowed.
STRAPI_BASE_URL=http://localhost:1337
# Bearer token for the Strapi GraphQL API. Needs read access to projects,
# dashboard panels, mapped tools, strategies and tool configurations.
STRAPI_TOKEN=
