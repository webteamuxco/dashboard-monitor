        <mxCell id="portsLane" value="strategy/  +  factory/  +  shared/factory/  —  ports (TS interfaces)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;fontSize=12;fontStyle=1;" vertex="1" parent="1">
