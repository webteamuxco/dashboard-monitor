        <mxCell id="iStrategy" value="«interface» ErrorMonitorStrategyInterface&#xa;──────────────&#xa;+ getIssues(projectId: string, filters?: IssueFilters): Promise&lt;Issue[]&gt;&#xa;+ getErrorStats(projectId: string, period: Period, environment?: string): Promise&lt;TimeSeriesPoint[]&gt;&#xa;+ getIssue(issueId: string): Promise&lt;Issue&gt;&#xa;+ getIssueLatestEvent(issueId: string): Promise&lt;IssueEvent | null&gt;&#xa;+ getIssueEvents(issueId: string, limit?: number): Promise&lt;IssueEvent[]&gt;&#xa;+ getIssueComments(issueId: string): Promise&lt;IssueComment[]&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingTop=6;spacingLeft=10;" vertex="1" parent="1">
