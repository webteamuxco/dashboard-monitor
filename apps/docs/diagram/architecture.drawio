<mxfile host="Electron" agent="claude" pages="2">
  <diagram name="1. Overview" id="overview">
    <mxGraphModel dx="1422" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="dashboard-monitor — Overview" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1520" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Which adapter runs is decided per project in Strapi admin. The environment only carries the API secrets." style="text;html=1;align=center;fontSize=12;fontStyle=2;fontColor=#666666" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1520" height="20" as="geometry" />
        </mxCell>

        <mxCell id="zoneBrowser" value="Browser (Client)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1520" height="170" as="geometry" />
        </mxCell>
        <mxCell id="reactComp" value="React Components&#xa;Panels (Issues, ErrorRate, Reservations)&#xa;KPI row + IssueDetailSheet&#xa;ProjectSelector · WindowSelector · EnvironmentSelector" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="130" width="350" height="110" as="geometry" />
        </mxCell>
        <mxCell id="tanstack" value="TanStack Query (server state)&#xa;useIssues · useIssueDetail · useErrorRate&#xa;useReservations · useVisitorsTimeline&#xa;useProjects · useProjectConfig&#xa;cache + polling + retry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="130" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="zustand" value="Zustand (UI state only)&#xa;useSelectedProject (persisted, skipHydration)&#xa;useDashboardWindow (presets + windowMinutes)&#xa;useEnvironment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="130" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="browserNote" value="Rules&#xa;· no server data in Zustand&#xa;· no UI state in TanStack&#xa;· no secrets on the client&#xa;· documentId is the only id that crosses" style="shape=note;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;spacingTop=6;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1230" y="130" width="300" height="110" as="geometry" />
        </mxCell>

        <mxCell id="zoneServer" value="Next.js Server — src/app/api/* · src/app/features/*/data-access · src/lib/{error,log,tracker}Monitor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="1520" height="600" as="geometry" />
        </mxCell>
        <mxCell id="routes" value="Route Handlers (force-dynamic)&#xa;/api/issues · /api/issues/[id] · /api/error-rate&#xa;/api/reservations · /api/visitors/timeline&#xa;/api/config/projects · /api/config/projects/[projectId]&#xa;every data route requires ?documentId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="340" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="dataAccess" value="Data Access [server-only, React cache()]&#xa;IssuesDataAccess · ErrorRateDataAccess&#xa;ReservationsDataAccess · VisitorsTimelineDataAccess&#xa;&#xa;const factory = await get&lt;Family&gt;Monitor(documentId)&#xa;const connection = await factory.createConnection(documentId)&#xa;const strategy = factory.createStrategy(connection)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingTop=6;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="340" width="480" height="110" as="geometry" />
        </mxCell>
        <mxCell id="configDA" value="ConfigDataAccess [server-only]&#xa;getProjectsList() → ProjectSummary[]&#xa;getProjectConfig(documentId) → Project" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1090" y="340" width="440" height="110" as="geometry" />
        </mxCell>

        <mxCell id="entry" value="get&lt;Family&gt;Monitor(documentId)  [server-only]&#xa;GetErrorMonitor.ts · GetLogMonitor.ts · GetTrackerMonitor.ts&#xa;module scope: factories = [ new GlitchTipFactory(), … ]&#xa;→ Resolver.resolve(documentId) : Promise&lt;Factory&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="490" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="resolver" value="&lt;Family&gt;MonitorResolver  [server-only]&#xa;STRATEGY_RESOLVER = &quot;error-monitor&quot; | &quot;log-monitor&quot; | &quot;tracker-monitor&quot;&#xa;for (factory of factories)&#xa;   if (await factory.support(documentId, STRATEGY_RESOLVER)) return factory&#xa;else throw &quot;No …Factory supports type … Please add missing Mapped tools in admin.&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="490" width="480" height="100" as="geometry" />
        </mxCell>
        <mxCell id="factoryInterface" value="«interface» FactoryInterface&lt;TStrategy&gt;&#xa;support(documentId, strategyResolver): Promise&lt;boolean&gt;&#xa;createConnection(documentId): Promise&lt;ToolConnection&gt;&#xa;createStrategy(connection): TStrategy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1090" y="490" width="440" height="100" as="geometry" />
        </mxCell>

        <mxCell id="abstractFactory" value="Abstract&lt;Vendor&gt;Factory  [server-only, shared/factory/]&#xa;TOOL_RESOLVER = &quot;glitchtip&quot; | &quot;posthog&quot;&#xa;support() → ConfigurationStrategy.isConfigure(documentId, strategy, TOOL_RESOLVER)&#xa;createConnection() → ConfigurationStrategy.resolveConnection(documentId)&#xa;create&lt;Vendor&gt;Client() → reads the env secret, builds the HTTP client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="630" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="concreteFactory" value="Concrete Factory (family × vendor)  [server-only]&#xa;GlitchTipFactory · GlitchTipLogMonitorFactory · PostHogFactory&#xa;extends Abstract&lt;Vendor&gt;Factory&#xa;implements &lt;Family&gt;MonitorFactoryInterface&#xa;only createStrategy(connection)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="630" width="480" height="110" as="geometry" />
        </mxCell>
        <mxCell id="strategyInterface" value="«interface» &lt;Family&gt;MonitorStrategyInterface&#xa;errorMonitor: getIssues · getErrorStats · getIssue&#xa;                     getIssueLatestEvent · getIssueEvents · getIssueComments&#xa;logMonitor: getLogs(projectId, filters?, period?)&#xa;trackerMonitor: getActiveUsersTimeline(projectId, windowMinutes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1090" y="630" width="440" height="110" as="geometry" />
        </mxCell>

        <mxCell id="concreteStrategy" value="Concrete Strategy  [server-only]&#xa;GlitchTipErrorMonitorStrategy · GlitchTipLogMonitorStrategy&#xa;PostHogStrategy&#xa;uses the HTTP client + mappers (DTO → domain)&#xa;receives connection.projectId — never the Strapi documentId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="780" width="480" height="100" as="geometry" />
        </mxCell>
        <mxCell id="httpClients" value="HTTP clients  [server-only, src/lib/tool/]&#xa;GlitchTipClient — get / getPaginated (Link cursor), Bearer&#xa;PostHogClient — POST HogQL /api/projects/{id}/query/, Bearer&#xa;transport only: throws on non-2xx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1090" y="780" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="secretNote" value="process.env (server-only secrets)&#xa;GLITCHTIP_TOKEN&#xa;POSTHOG_PERSONAL_API_KEY&#xa;STRAPI_BASE_URL / STRAPI_TOKEN&#xa;&#xa;No driver env var: the adapter&#xa;comes from Strapi mapped tools." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingTop=6;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="780" width="440" height="100" as="geometry" />
        </mxCell>

        <mxCell id="zoneConfig" value="Config layer — src/lib/config/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="930" width="800" height="240" as="geometry" />
        </mxCell>
        <mxCell id="cfgStrategy" value="Tool configuration strategies  [React cache()]&#xa;GlitchtipConfigurationStrategy · PosthogConfigurationStrategy&#xa;isConfigure(documentId, strategyName, toolSlug): Promise&lt;boolean&gt;&#xa;resolveConnection(documentId): Promise&lt;ToolConnection&gt;&#xa;ToolConnection { baseUrl, projectId } (+ organizationSlug for GlitchTip)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
